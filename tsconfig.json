{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    // Resolved at runtime by `tsconfig-paths` (loaded from hardhat-base-config.ts and the maths:check script).
    "paths": {
      // Hardhat test helpers.
      "@helpers/*": ["test/helpers/*"],
      // Typechain output of `npm run compile`: this repo's contracts under `@typechain/contracts/...`, the
      // @bush.fi/v3-* packages under `@typechain/@bush.fi/v3-<pkg>/...`.
      "@typechain": ["typechain-types/index.ts"],
      "@typechain/*": ["typechain-types/*"],
      // The off-chain maths (TypeScript), used by maths/check.
      "@bush.fi/maths": ["maths/typescript/src/index.ts"],
      "@bush.fi/maths/*": ["maths/typescript/src/*"],
      "@/*": ["maths/typescript/src/*"]
    }
  },
  "include": ["hardhat.config.ts", "hardhat-base-config.ts", "scripts/**/*.ts", "test/hardhat/**/*.ts", "test/helpers/**/*.ts", "maths/check/**/*.ts", "typechain-types/**/*.ts"],
  "exclude": ["node_modules", "artifacts", "forge-artifacts"]
}
