// Exact port of contracts/__family__/__Pascal__Hook.sol, implementing the bush-maths `HookBase` interface so the
// bush-maths Vault flow calls it around swaps, adds and removes, as the on-chain Vault does.
//
// Rules for a port that matches the contract to the wei:
//   - the should* flags below mirror __Pascal__Hook.getHookFlags() exactly (the Vault only calls what's switched on);
//   - use bigint and the bush-maths fixed-point helpers (MathSol.mulDownFixed etc.), never floating point;
//   - mirror every rounding direction of the Solidity call for call;
//   - import only from '../poolKit' (and this file).

import {
    AddKind,
    type AfterSwapParams,
    type HookBase,
    type HookStateBase,
    RemoveKind,
    type SwapParams,
} from '../poolKit';

/** What the maths needs from the chain: the adapter's `hook.dynamicData()` fields (maths/check/adapters/__factory__.ts). */
export type HookState__Pascal__ = HookStateBase & {
    hookType: '__Pascal__';
    // TODO: the hook's parameters, e.g. a fee rate (as bigint).
};

export class __Pascal__Hook implements HookBase {
    // TODO: mirror __Pascal__Hook.getHookFlags().
    public shouldCallComputeDynamicSwapFee = false;
    public shouldCallBeforeSwap = false;
    public shouldCallAfterSwap = false;
    public shouldCallBeforeAddLiquidity = false;
    public shouldCallAfterAddLiquidity = false;
    public shouldCallBeforeRemoveLiquidity = false;
    public shouldCallAfterRemoveLiquidity = false;
    public enableHookAdjustedAmounts = false;

    // __Pascal__Hook.onComputeDynamicSwapFeePercentage
    onComputeDynamicSwapFee(params: SwapParams, pool: string, staticSwapFeePercentage: bigint, hookState: HookState__Pascal__ | unknown) {
        return { success: true, dynamicSwapFee: staticSwapFeePercentage };
    }

    // __Pascal__Hook.onBeforeSwap
    onBeforeSwap(params: SwapParams & { hookState: HookState__Pascal__ | unknown }) {
        return { success: true, hookAdjustedBalancesScaled18: params.balancesLiveScaled18 };
    }

    // __Pascal__Hook.onAfterSwap
    onAfterSwap(params: AfterSwapParams) {
        return { success: true, hookAdjustedAmountCalculatedRaw: params.amountCalculatedRaw };
    }

    // __Pascal__Hook.onBeforeAddLiquidity
    onBeforeAddLiquidity(kind: AddKind, maxAmountsInScaled18: bigint[], minBptAmountOut: bigint, balancesScaled18: bigint[], hookState: HookState__Pascal__ | unknown) {
        return { success: true, hookAdjustedBalancesScaled18: balancesScaled18 };
    }

    // __Pascal__Hook.onAfterAddLiquidity
    onAfterAddLiquidity(kind: AddKind, amountsInScaled18: bigint[], amountsInRaw: bigint[], bptAmountOut: bigint, balancesScaled18: bigint[], hookState: HookState__Pascal__ | unknown) {
        return { success: true, hookAdjustedAmountsInRaw: amountsInRaw };
    }

    // __Pascal__Hook.onBeforeRemoveLiquidity
    onBeforeRemoveLiquidity(kind: RemoveKind, maxBptAmountIn: bigint, minAmountsOutScaled18: bigint[], balancesScaled18: bigint[], hookState: HookState__Pascal__ | unknown) {
        return { success: true, hookAdjustedBalancesScaled18: balancesScaled18 };
    }

    // __Pascal__Hook.onAfterRemoveLiquidity
    onAfterRemoveLiquidity(kind: RemoveKind, bptAmountIn: bigint, amountsOutScaled18: bigint[], amountsOutRaw: bigint[], balancesScaled18: bigint[], hookState: HookState__Pascal__ | unknown) {
        return { success: true, hookAdjustedAmountsOutRaw: amountsOutRaw };
    }
}
