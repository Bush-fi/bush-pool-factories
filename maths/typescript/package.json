{
  "name": "@bush.fi/maths",
  "version": "0.1.2",
  "description": "Exact fixed-point reference maths for Bush Protocol pools: the amounts the on-chain Vault returns, computed off-chain.",
  "license": "MIT",
  "homepage": "https://github.com/Bush-fi/bush-pool-factories/tree/main/maths/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bush-fi/bush-pool-factories.git",
    "directory": "maths/typescript"
  },
  "bugs": {
    "url": "https://github.com/Bush-fi/bush-pool-factories/issues"
  },
  "keywords": [
    "bush",
    "defi",
    "amm",
    "maths",
    "weighted-pool",
    "stable-pool",
    "lbp",
    "reclamm",
    "bigint"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest dev",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
