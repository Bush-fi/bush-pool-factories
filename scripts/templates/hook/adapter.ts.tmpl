// needs for the pool and for the hook. See maths/check/README.md.

import { FactoryAdapter } from '../src/types';

const adapter: FactoryAdapter = {
  // One test-data file per variant. Cover what changes a code path in the hook's maths: token decimals (the Vault
  // scales every balance to 18 decimals), and each of the hook's parameters.
  variants: {
__VARIANTS__
  },

  async createPool(ctx) {
